# Samba Configuration
# https://github.com/dperson/samba

# Timezone
TZ={{ timezone | default('America/Vancouver') }}

# User/Group IDs
USERID={{ samba_puid | default('1001') }}
GROUPID={{ samba_pgid | default('1001') }}

# Share definitions
# Format: name;path;browsable;readonly;guest;users;admins;writelist;comment
# Example: MyShare;/data;yes;no;yes
{% for share in samba_shares | default([]) %}
{% if loop.first %}
SHARE={{ share }}
{% else %}
SHARE{{ loop.index }}={{ share }}
{% endif %}
{% endfor %}

# Recycle bin
# The dperson/samba image enables Samba's recycle VFS module in [global],
# moving every SMB deletion into .deleted with keeptree/no size cap and no
# expiry, so it grows without bound. Any non-empty value makes the image's
# entrypoint strip it from smb.conf at startup.
RECYCLE=1

# Workgroup (optional)
# WORKGROUP=WORKGROUP

# NMBD - enable NetBIOS name service (optional)
# NMBD=true
