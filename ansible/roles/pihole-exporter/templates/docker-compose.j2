services:
  pihole-exporter:
    container_name: pihole-exporter
    image: ekofr/pihole-exporter:latest
    ports:
      - "9617:9617"
    # raw: pass values through untouched, so a "$" or quote in a Pi-hole
    # password isn't interpolated or stripped by Compose
    env_file:
      - path: .env
        format: raw
    environment:
      TZ: '{{ timezone }}'
    restart: unless-stopped
