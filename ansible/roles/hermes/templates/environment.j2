# Hermes Agent Environment Configuration
# Docs: https://hermes-agent.nousresearch.com/docs/user-guide/docker/
# LLM provider keys live in the data volume's .env (written by `hermes setup`), not here.

# Dashboard basic auth (generated at setup)
HERMES_DASHBOARD_BASIC_AUTH_USERNAME={{ hermes_dashboard_username | default('admin') }}
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD={{ hermes_dashboard_password | default(lookup('ansible.builtin.password', '/dev/null', chars=['ascii_letters', 'digits'], length=32)) }}

# Session signing secret so dashboard logins survive restarts (generated at setup)
HERMES_DASHBOARD_BASIC_AUTH_SECRET={{ hermes_dashboard_secret | default(lookup('ansible.builtin.password', '/dev/null', chars=['hexdigits'], length=64)) }}
