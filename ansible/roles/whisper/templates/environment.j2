# Whisper ASR Webservice Environment Configuration

# ASR engine: openai_whisper | faster_whisper | whisperx
ASR_ENGINE={{ whisper_asr_engine | default('faster_whisper') }}

# Model size: tiny | base | small | medium | large-v3 | ...
ASR_MODEL={{ whisper_asr_model | default('base') }}

# Inference device: cpu | cuda
ASR_DEVICE={{ whisper_asr_device | default('cpu') }}

# Unload the model from memory after N seconds of inactivity (0 = never)
MODEL_IDLE_TIMEOUT={{ whisper_model_idle_timeout | default('300') }}

# Speaker diarization (whisperx engine only). Requires a HuggingFace token with
# accepted user conditions for pyannote/speaker-diarization-3.1 and
# pyannote/segmentation-3.0. Request per-call with ?diarize=true.
HF_TOKEN={{ whisper_hf_token | default('') }}

# Timezone
TZ={{ timezone | default('America/Vancouver') }}
